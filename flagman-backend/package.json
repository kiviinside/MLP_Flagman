{
  "name": "flagman-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@flagman/web",
    "build": "npm run build --workspace=@flagman/web",
    "preview": "npm run preview --workspace=@flagman/web",
    "backend:run": "mvn -f backend/pom.xml spring-boot:run",
    "backend:test": "mvn -f backend/pom.xml test",
    "test": "npm run build && npm run backend:test"
  }
}

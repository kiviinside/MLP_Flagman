# Для production обязательно задать собственные пароли.
ADMIN_PASSWORD=change-this-admin-password
STAFF_PASSWORD=change-this-staff-password
# PostgreSQL — включается через переменные Spring datasource.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flagman
SPRING_DATASOURCE_USERNAME=flagman
SPRING_DATASOURCE_PASSWORD=change-this-database-password

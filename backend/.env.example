# Example for PostgreSQL profile. Do not commit real credentials.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flagman
SPRING_DATASOURCE_USERNAME=flagman
SPRING_DATASOURCE_PASSWORD=replace-me
# Comma-separated origins allowed by Spring Security CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
